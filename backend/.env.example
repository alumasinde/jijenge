# Local Docker environment only. Never commit a real .env file.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=15s
APP_MAX_BODY_BYTES=1048576
APP_RATE_LIMIT_REQUESTS=120
APP_RATE_LIMIT_WINDOW=1m
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Use a long random value in real deployments.
APP_SECRET_KEY=replace-with-at-least-32-random-bytes

MYSQL_DATABASE=jijenge
MYSQL_USER=jijenge_app
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

DB_DRIVER=mysql
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
