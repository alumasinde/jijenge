# Jijenge local/Docker environment
APP_NAME=Jijenge
APP_ENV=development
APP_DEBUG=true

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=services_platform
MYSQL_USER=services_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

JWT_SECRET=replace_with_at_least_64_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_MINUTE=10

UVICORN_WORKERS=2
